# Скопируйте в .env (это делает deploy/deploy.sh). Сам .env в git не коммитится.

# Ключ связи бот -> backend (заголовок X-API-Key).
# Оставьте пустым: скрипт развертывания сгенерирует его при первом запуске.
BOT_API_KEY=

# Порт для проверок бэкенда с хоста.
BACKEND_PORT=8080

# Адрес, на котором слушает порт: 0.0.0.0 (снаружи) или 127.0.0.1 (только с самого сервера).
# Если бот запущен в той же compose-сети, снаружи порт не нужен: поставьте 127.0.0.1.
BACKEND_BIND=127.0.0.1

# Telegram-бот. Чтобы включить его, укажите токен и раскомментируйте профиль.
BOT_TOKEN=
# COMPOSE_PROFILES=bot
# Опциональный прокси Webshare для Telegram: http://user:password@host:port
TELEGRAM_PROXY_URL=

# Генерация рецептов через OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Опциональный HTTPS-маршрут бэкенда через HTTP-прокси.
OPENROUTER_PROXY_URL=
